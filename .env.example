# Yahoo Developer App Credentials
# Get these from https://developer.yahoo.com/apps/
YAHOO_CONSUMER_KEY=your_consumer_key_here
YAHOO_CONSUMER_SECRET=your_consumer_secret_here

# League Configuration
# Find your league_id in the Yahoo Fantasy URL: https://basketball.fantasysports.yahoo.com/nba/{league_id}
YAHOO_LEAGUE_ID=your_league_id_here

# Team Configuration (optional - will auto-detect if not set)
# Your team number in the league (1, 2, 3, etc.)
YAHOO_TEAM_ID=

# Game Code (default: nba for basketball)
YAHOO_GAME_CODE=nba
